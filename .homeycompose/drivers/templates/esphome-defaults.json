{
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "discovery": "esphome",
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "options": {
        "singular": true
      },
      "navigation": {
        "next": "loading"
      }
    },
    {
      "id": "list_ble_devices",
      "template": "list_devices",
      "options": {
        "singular": true
      },
      "navigation": {
        "next": "enter_wifi"
      }
    },
    {
      "id": "enter_wifi",
      "$template": "enter_wifi"
    },
    {
      "id": "configure_manual",
      "$template": "configure_manual"
    },
    {
      "id": "enter_key",
      "$template": "enter_key"
    },
    {
      "id": "loading",
      "template": "loading"
    },
    {
      "id": "add_device",
      "$template": "add_device"
    }
  ],
  "repair": [
    {
      "id": "maintenance",
      "$template": "maintenance"
    },
    {
      "id": "configure_manual",
      "$template": "configure_manual",
      "navigation": false
    },
    {
      "id": "show_key",
      "$template": "show_key",
      "navigation": false
    },
    {
      "id": "enter_key",
      "$template": "enter_key"
    }
  ],
  "settings": [
    {
      "$extends": "esphome-device-information"
    }
  ],
  "icon": "{{driverAssetsPath}}/icon.svg"
}
